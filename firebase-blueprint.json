{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with username",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["username", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    }
  }
}
